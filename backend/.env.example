# Environment variables for AI VTuber
# Copy this file to .env and fill in your values

# OpenAI API key (for cloud LLM providers like OpenAI, Anthropic, Gemini)
# Not needed for local llama.cpp server — leave empty or remove this line
OPENAI_API_KEY=

# OpenRouter hosted TTS (for example fish-audio/s2.1-pro-free:free)
# Used only when the TTS engine is set to OpenRouter in the web UI.
OPENROUTER_API_KEY=

# Fish Audio voice-directory search (optional; this is separate from
# OpenRouter TTS and is only needed to search/select Fish voice IDs)
FISH_AUDIO_API_KEY=

# Discord bot
DISCORD_BOT_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: override config file path (defaults to config/config.yaml)
# CONFIG_PATH=config/config.yaml
