# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
tmp*/
.venv/
venv/
dist/
build/
*.db
!data/
data/*
!data/character-profiles/
# Character profiles, presets, databases, datasets, tokens, and migration
# markers are created or modified during app use. Keep only the shipped,
# editable trait catalog in version control.
data/character-profiles/*
!data/character-profiles/trait-library.md
data/presets/
data/datasets/
data/*.sqlite
data/*.sqlite3
data/*token*.json
data/*acceptance*.json
data/*license*.json

# Local session notes and runtime planning files
/session-ses*.md
/GOALS.md

# Node
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
*.local

# Packaged desktop build output
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/resources/VtubecordServer.exe
desktop/src-tauri/resources/VtubecordUpdater.exe
desktop/src-tauri/resources/update-config.json
desktop/src-tauri/resources/*.dll
